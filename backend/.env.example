NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/spendwise_db?schema=public"
JWT_ACCESS_SECRET="replace_with_strong_random_access_secret_at_least_32_chars"
JWT_REFRESH_SECRET="replace_with_strong_random_refresh_secret_at_least_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=30
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN="*"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
DEFAULT_CURRENCY="INR"
